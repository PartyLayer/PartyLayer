{
  "name": "partylayer-demo",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-registry.mjs",
    "dev": "rm -rf .next && next dev",
    "prebuild": "node scripts/copy-registry.mjs && node ../../scripts/gen-ai-docs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pretest": "node scripts/copy-registry.mjs",
    "test": "tsx --test --test-force-exit src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:pr": "playwright test smoke.spec.ts full-connect-flow.spec.ts vala-beta.spec.ts connection-keyboard.spec.ts accessibility.spec.ts docs-accessibility.spec.ts developer-discovery.spec.ts session-persistence.spec.ts wallets/send.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@partylayer/adapter-console": "workspace:^",
    "@partylayer/adapter-loop": "workspace:^",
    "@partylayer/core": "workspace:^",
    "@partylayer/provider": "workspace:^",
    "@partylayer/react": "workspace:^",
    "@partylayer/sdk": "workspace:^",
    "@partylayer/session": "workspace:^",
    "@tanstack/react-query": "^5.101.0",
    "@walletconnect/sign-client": "^2.26.0",
    "@walletconnect/types": "^2.26.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "@partylayer/testing": "workspace:^",
    "esbuild": "^0.27.2",
    "dotenv": "^17.2.4"
  }
}
