# DvP demo environment (all optional; copy to .env.local to override).

# Backend: unset (or anything but "live") uses the in-browser demo backend.
# "live" routes every read and submit to the DevNet gateway at VITE_GATEWAY_URL.
# VITE_BACKEND=live
# VITE_GATEWAY_URL=/api

# WalletConnect Cloud project id. The app ships a shared public dev fallback so the
# WalletConnect QR works out of the box; set your own for a production deploy.
# Get one at https://cloud.walletconnect.com
# VITE_WALLETCONNECT_PROJECT_ID=your_project_id

# Bron (enterprise remote signer). Bron only appears in the wallet picker when ALL
# of these are set; without real OAuth2 credentials a click could only dead-end at
# an auth error, so the SDK hides it. Provide an enterprise Bron OAuth app's values:
# VITE_BRON_AUTHORIZATION_URL=https://auth.bron.example/oauth/authorize
# VITE_BRON_TOKEN_URL=https://auth.bron.example/oauth/token
# VITE_BRON_CLIENT_ID=your_client_id
# VITE_BRON_REDIRECT_URI=https://dvp.partylayer.xyz/bron/callback
# VITE_BRON_API_URL=https://api.bron.example
