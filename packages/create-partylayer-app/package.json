{
  "name": "create-partylayer-app",
  "version": "0.7.0",
  "description": "Create a Canton Network dApp with PartyLayer: React, Next.js, Vue and TypeScript starters with wallet integration and ready-made React Connect Wallet UI.",
  "type": "module",
  "bin": {
    "create-partylayer-app": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.5.1",
    "mri": "1.2.0",
    "picocolors": "1.1.1",
    "semver": "7.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/semver": "7.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PartyLayer/PartyLayer.git",
    "directory": "packages/create-partylayer-app"
  },
  "homepage": "https://partylayer.xyz/docs/installation",
  "bugs": {
    "url": "https://github.com/PartyLayer/PartyLayer/issues"
  },
  "license": "MIT",
  "keywords": [
    "partylayer",
    "canton",
    "wallet",
    "create",
    "scaffold",
    "cli",
    "dapp",
    "starter",
    "canton-network",
    "cip-0103",
    "react",
    "nextjs",
    "vite",
    "vue",
    "typescript",
    "connect-wallet"
  ]
}
