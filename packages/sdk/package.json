{
  "name": "@partylayer/sdk",
  "version": "0.20.1",
  "sideEffects": false,
  "description": "TypeScript wallet integration SDK for Canton Network, with CIP-0103 provider access, wallet discovery, sessions and supported wallet runtimes.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "canton",
    "wallet",
    "sdk",
    "dapp",
    "canton-network",
    "cip-0103",
    "wallet-integration",
    "wallet-discovery",
    "typescript",
    "web3"
  ],
  "author": "PartyLayer Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PartyLayer/PartyLayer.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://partylayer.xyz/docs/vanilla-js",
  "bugs": {
    "url": "https://github.com/PartyLayer/PartyLayer/issues"
  },
  "dependencies": {
    "@canton-network/core-types": "1.14.0",
    "@canton-network/core-wallet-discovery": "1.15.0",
    "@canton-network/dapp-sdk": "0.24.0",
    "@k2flabs/walley-dapp-sdk": "1.2.0",
    "@lithiumdigital/cauri-dapp-sdk": "0.2.0",
    "@oneswap/wallet-cip0103-adapter": "0.2.0",
    "@partylayer/adapter-bron": "workspace:^",
    "@partylayer/adapter-cantor8": "workspace:^",
    "@partylayer/adapter-console": "workspace:^",
    "@partylayer/adapter-loop": "workspace:^",
    "@partylayer/adapter-nightly": "workspace:^",
    "@partylayer/adapter-send": "workspace:^",
    "@partylayer/adapter-walletconnect": "workspace:^",
    "@partylayer/core": "workspace:^",
    "@partylayer/provider": "workspace:^",
    "@partylayer/registry-client": "workspace:^",
    "@vala-wallet/dapp-sdk": "0.1.0",
    "@walletconnect/sign-client": "^2.23.8",
    "@walletconnect/types": "^2.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
